# ---------------------------------------------------------------------------
# Warrant configuration. Copy to `.env` and fill in.
# All secrets come from the environment; the app fails fast if a required
# key is missing when running in LIVE mode (WARRANT_MOCK=0).
# ---------------------------------------------------------------------------

# --- Provider credentials (required in live mode) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Models (configurable; not hardcoded in business logic) ---
# Orchestrator = strong reasoning model used as the planner / approval gate.
WARRANT_ORCHESTRATOR_MODEL=claude-opus-4-8
# Worker = cheaper model for extraction / writing executors.
WARRANT_WORKER_MODEL=gpt-4o-mini
# Optional stronger worker for hard subtasks (cost-aware routing).
WARRANT_WORKER_STRONG_MODEL=gpt-4o

# --- Run mode ---
# 1 = mock/offline (no network, deterministic stubs); 0 = live API calls.
WARRANT_MOCK=1

# --- Posterior elicitation ---
# K self-consistency samples per posterior elicitation.
WARRANT_POSTERIOR_SAMPLES=5
# Sampling temperature for posterior elicitation.
WARRANT_POSTERIOR_TEMPERATURE=0.7

# --- Delegation economics ---
# KL threshold below which a delegation's observation is deemed redundant
# (the a-posteriori novelty audit). Delegations that never clear this get pruned.
WARRANT_NOVELTY_KL_EPSILON=0.05

# --- Risk-triggered escalation (Theorem 10: escalate iff R_a(H) > R_h(H)) ---
# Cost of a wrong terminal decision on a load-bearing claim.
WARRANT_WRONG_COST=1.0
# Cost of routing a claim to a human reviewer.
WARRANT_REVIEW_COST=0.15

# --- Output ---
WARRANT_OUTPUT_DIR=./out
WARRANT_LOG_LEVEL=INFO
